# Site lock — required for the password gate to work.
# Real values live in .env.local (dev) and Vercel project env vars (prod).
# Never commit real values. If both are unset, the site fails CLOSED (everything
# redirects to the landing and nothing can be unlocked).

# scrypt hash of the universal site password, format "saltHex:keyHex".
# Generate with:  node scripts/gen-password-hash.mjs "your strong passphrase"
SITE_PASSWORD_HASH=

# Random key used to sign session cookies (HMAC-SHA256). Rotating this instantly
# logs everyone out. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
